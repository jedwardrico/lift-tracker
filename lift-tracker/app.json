{
  "expo": {
    "name": "LiftTracker",
    "slug": "lift-tracker",
    "version": "1.0.27",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.lift-tracker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "scheme": "lift-tracker",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "backgroundColor": "#0a0a0a"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/1df8d808-46fb-4689-a049-8e565861c160"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "1df8d808-46fb-4689-a049-8e565861c160"
      }
    }
  }
}
